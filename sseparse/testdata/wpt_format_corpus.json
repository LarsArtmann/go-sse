  {
    "name": "TrailingCREndsLineAtEOF",
    "url": "derived:§9.2.5 end-of-line = cr lf / cr / lf",
    "notes": "A lone CR terminates the line even when EOF follows immediately, so this frame's data line is complete — but the blank line required to dispatch it never arrives, and the frame is discarded at EOF.",
    "wire": "data: x\r"
  }
